# Nushell config
# version = "0.110.0"
#
# Nushell loads its own defaults first (default_config.nu). Only overrides
# live here; run `config nu --default` to see every available setting.

# ============================================================================
# Settings
# ============================================================================
$env.config.show_banner = false
$env.config.edit_mode = "vi"
$env.config.cursor_shape = {
    vi_insert: block
    vi_normal: underscore
    emacs: block
}
$env.config.filesize.unit = "binary"
$env.config.completions.case_sensitive = false
$env.config.completions.algorithm = "prefix"
$env.config.history.max_size = 100_000

# direnv: reload the environment before every prompt
$env.config.hooks.pre_prompt = [{||
    if (which direnv | is-empty) {
        return
    }
    try {
        direnv export json | from json | default {} | load-env
        if 'PATH' in $env {
            $env.PATH = ($env.PATH | split row (char esep))
        }
    } catch {}
}]

# ============================================================================
# Custom commands
# ============================================================================
# cd into a directory and list it
def --env cx [dir: path] {
    cd $dir
    ls -l
}

# macOS: fuzzy-pick an AeroSpace window and focus it
def ff [] {
    aerospace list-windows --all
    | fzf --bind 'enter:execute(bash -c "aerospace focus --window-id {1}")+abort'
}

# ============================================================================
# Aliases
# ============================================================================
# General
alias l = ls --all
alias ll = ls -l
alias lt = eza --tree --level=2 --long --icons --git
alias c = clear
alias v = nvim
alias hms = home-manager switch
alias asr = atuin scripts run
alias as = aerospace

# Git
alias gst = git status
alias gc = git commit -m
alias gca = git commit -a -m
alias gp = git push origin HEAD
alias gpu = git pull origin
alias gco = git checkout
alias gcoall = git checkout -- .
alias gb = git branch
alias gba = git branch -a
alias gadd = git add
alias ga = git add -p
alias gdiff = git diff
alias gr = git remote
alias gre = git reset
alias glog = git log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit

# Kubernetes
alias k = kubectl
alias ka = kubectl apply -f
alias kg = kubectl get
alias kgpo = kubectl get pod
alias kgd = kubectl get deployments
alias kd = kubectl describe
alias kdel = kubectl delete
alias kl = kubectl logs
alias ke = kubectl exec -it
alias kc = kubectx
alias kns = kubens

# ============================================================================
# Tool integrations (files generated by env.nu)
# ============================================================================
source ~/.cache/nushell/zoxide.nu
source ~/.cache/nushell/carapace.nu
source ~/.cache/nushell/atuin.nu
use ~/.cache/nushell/starship.nu
